{
  "name": "conceptbox",
  "private": true,
  "type": "module",
  "dependencies": {
    "@mit-sdg/sync-engine": "1.1.0",
    "@mit-sdg/sync-engine-http": "1.1.0",
    "mongodb": "^7.2.0"
  },
  "devDependencies": {
    "@mit-sdg/sync-engine-analysis": "1.1.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "mongodb-memory-server": "^11.2.0",
    "typescript": ">=6 <7"
  },
  "overrides": {
    "bson": "7.2.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "PUBLIC_ORIGIN=http://localhost:5173 bun --watch src/host/server.ts",
    "start": "bun src/host/server.ts",
    "build": "bun run --cwd frontend build",
    "generate": "sync-engine artifacts pin",
    "check": "sync-engine check && sync-engine artifacts check && tsc --noEmit",
    "test": "bun test --timeout 60000",
    "trace": "TRACE=1 bun test tests/compositions/walkthrough.test.ts",
    "storage": "bun scripts/storage.ts start",
    "storage:setup": "bun scripts/storage.ts setup"
  }
}
